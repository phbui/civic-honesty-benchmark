    given-names: Phi
repository-code: "https://github.com/phbui/civic-honesty-benchmark"
license: MIT
references:
  - type: data
    title: "Street Pavement Rating (NYC Open Data)"
    authors:
      - name: "New York City Department of Transportation"
    url: "https://data.cityofnewyork.us"
