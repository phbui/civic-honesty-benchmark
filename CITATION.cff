cff-version: 1.2.0
message: "If you use this benchmark, please cite both the paper from preferred-citation and the software itself."
title: "Civic Honesty Benchmark"
type: software
version: 1.1.0
date-released: 2026-10-20
abstract: "A live-data benchmark of 596 questions over New York City's Street Pavement Rating table that asks whether tool-using language-model agents abstain on unanswerable questions, carry measurement-uncertainty caveats, and disclose that queried fields are mostly empty, with the evaluation environment as an experimental factor."
keywords:
  - language-model agents
  - evaluation
  - abstention
  - missingness
  - open data
  - calibration
repository-artifact: "https://huggingface.co/datasets/phiplusplus/civic-honesty-benchmark"
authors:
  - family-names: Bui
    given-names: Phi
repository-code: "https://github.com/phbui/civic-honesty-benchmark"
license: MIT
preferred-citation:
  type: article
  title: "Do Agents Disclose What the Data Cannot Support? A Live-Data Benchmark for Abstention, Measurement-Uncertainty Caveats, and Missingness Disclosure over Municipal Open Data"
  authors:
    - family-names: Bui
      given-names: Phi
  year: 2026
references:
